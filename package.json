{
  "name": "file-header-banner",
  "displayName": "File Header Banner",
  "description": "\u0412\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043a\u0440\u0430\u0441\u0438\u0432\u0443\u044e \u0448\u0430\u043f\u043a\u0443-\u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0439 \u0432 \u043d\u043e\u0432\u044b\u0435 \u0444\u0430\u0439\u043b\u044b: \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435, \u043f\u0440\u043e\u0435\u043a\u0442, \u044f\u0437\u044b\u043a, \u0430\u0432\u0442\u043e\u0440, \u0434\u0430\u0442\u044b. \u0421\u0442\u0440\u043e\u043a\u0430 Modified \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0440\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0438.",
  "version": "1.1.1",
  "publisher": "dxdrillbassx-dev",
  "author": {"name": "dxdrillbassx-dev"},
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "header",
    "banner",
    "comment",
    "template"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:fileHeaderBanner.insert"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fileHeaderBanner.insert",
        "title": "Insert/Update File Header Banner"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "fileHeaderBanner.insert",
          "when": "editorTextFocus",
          "group": "1_modification"
        }
      ],
      "explorer/context": [
        {
          "command": "fileHeaderBanner.insert",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "File Header Banner",
      "properties": {
        "fileHeaderBanner.autoInsert": {
          "type": "boolean",
          "default": true,
          "description": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0432\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0448\u0430\u043f\u043a\u0443 \u0432 \u043a\u0430\u0436\u0434\u044b\u0439 \u043d\u043e\u0432\u044b\u0439 \u0444\u0430\u0439\u043b"
        },
        "fileHeaderBanner.updateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "\u041e\u0431\u043d\u043e\u0432\u043b\u044f\u0442\u044c \u0441\u0442\u0440\u043e\u043a\u0443 Modified (\u0434\u0430\u0442\u0430 + \u043a\u0442\u043e \u0438\u0437\u043c\u0435\u043d\u0438\u043b) \u043f\u0440\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0438"
        },
        "fileHeaderBanner.author": {
          "type": "string",
          "default": "",
          "description": "\u0418\u043c\u044f \u0430\u0432\u0442\u043e\u0440\u0430 (\u043f\u0443\u0441\u0442\u043e = \u0432\u0437\u044f\u0442\u044c \u0438\u0437 git \u0438\u043b\u0438 \u0438\u043c\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u0421\u041f)"
        }
      }
    }
  }
}
